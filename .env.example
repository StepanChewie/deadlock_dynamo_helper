# Required
DB_PASSWORD=replac…word
DEADLOCK_API_BASE_URL=https://api.deadlock-api.com

# Optional overrides
# DEADLOCK_API_BASE_URL=https://api.deadlock-api.com

# Optional. The upstream deadlock-api.com answers without a key -- verified with
# GET /v1/assets/items, which returned 200 and 5.7 MB -- and
# getDeadlockApiRequestConfig() sends no header at all when this is empty. It is
# left out on purpose: the key was leaked twice, and dropping it costs nothing.
# Set it only if the upstream starts rate-limiting the catalog imports.
# DEADLOCK_API_KEY=

# Guards operator-only routes (reference-data, live reads, debug page, statlocker
# probe). Unset makes those routes fail closed with 401 rather than become public.
INTERNAL_API_KEY=replac…-key

# Comma-separated CORS allowlist. Empty leaves the API permissive.
# The Overwolf client sends a non-standard Origin carrying the app UID:
#   https://www.overwolf.com/<uid>
# The whole string is compared, so a bare host does not match. The UID comes from
# meta.name + meta.author, so renaming the app changes this value.
CORS_ALLOWED_ORIGINS=

# Verified economy rules for the adaptive v2 recommendation pipeline.
# One-shot JSON published at container start into the economy rules store
# (rulesetId + catalogSha256 must match the imported item catalog).
# Leave empty to auto-generate canonical rules from the latest catalog version.
ADAPTIVE_ECONOMY_RULES_JSON=

# Production build debugger. Supply real secrets through deployment environment, never source control.
BUILD_DEBUG_PASSWORD=replac…word
BUILD_DEBUG_SESSION_SECRET=replac…cret
BUILD_DEBUG_SESSION_TTL_SEC=3600
BUILD_DEBUG_TRACE_TAIL=5
BUILD_DEBUG_TRACE_IDLE_TTL_SEC=1800
