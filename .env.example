DEADLOCK_API_KEY=replace-with-your-deadlock-api-key
DB_PASSWORD=replace-with-your-postgres-password
DEADLOCK_API_BASE_URL=https://api.deadlock-api.com
DEADLOCK_LIVE_EVENTS_BASE_URL=http://deadlock-live-events:3000
DEADLOCK_TIMELINE_COLLECTOR_ENABLED=true
DEADLOCK_TIMELINE_MAX_CONCURRENT_MATCHES=2
DEADLOCK_TIMELINE_STORAGE_DIR=/app/apps/api/storage/match-timeline-events-v1
DEADLOCK_RECOMMENDATION_DECISION_DATASET_V5_SOURCE_DIR=/app/apps/api/storage/recommendation-decision-dataset-v4
DEADLOCK_RECOMMENDATION_DECISION_DATASET_V5_DIR=/app/apps/api/storage/recommendation-decision-dataset-v5

# Roadmap/evidence control plane. Generate independent random secrets; never commit real values.
RECOMMENDATION_EVIDENCE_TOKEN=replace-with-random-secret
RECOMMENDATION_ROADMAP_EVIDENCE_TOKEN=replace-with-random-secret
RECOMMENDATION_ARTIFACT_REGISTRY_TOKEN=replace-with-random-secret
RECOMMENDATION_TRAINING_TOKEN=replace-with-random-secret

# Keep empty until a direct shop source has been independently validated.
# Format: OVERWOLF_GEP:onInfoUpdates2|feature|category|key
RECOMMENDATION_DIRECT_SHOP_SOURCE_ALLOWLIST=

# Behavioral serving is only needed after a verified model exists. Loopback HTTP is allowed; remote serving must use HTTPS.
RECOMMENDATION_BEHAVIORAL_SERVING_URL=
RECOMMENDATION_BEHAVIORAL_SERVING_TOKEN=replace-with-random-secret
RECOMMENDATION_BEHAVIORAL_SERVING_TIMEOUT_MS=150

# Development-only escape hatch for local immutable artifact tests. Keep false outside explicit local testing.
RECOMMENDATION_ALLOW_LOCAL_ARTIFACTS=false

# Production build debugger. Supply real secrets through deployment environment, never source control.
BUILD_DEBUG_PASSWORD=replace-with-debug-password
BUILD_DEBUG_SESSION_SECRET=replace-with-random-secret
BUILD_DEBUG_SESSION_TTL_SEC=3600
BUILD_DEBUG_TRACE_TAIL=5
BUILD_DEBUG_TRACE_IDLE_TTL_SEC=1800
