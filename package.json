{
  "name": "dynamo-lab",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "db:migrate": "yarn workspace @dynamo-lab/api migration:run",
    "db:revert": "yarn workspace @dynamo-lab/api migration:revert",
    "db:migrations": "yarn workspace @dynamo-lab/api migration:show",
    "db:generate": "yarn workspace @dynamo-lab/api migration:generate"
  }
}
